# LLM Poker Arena — Backend Environment Variables
# Copy this file to .env and fill in your credentials.
# NEVER commit .env — it is gitignored.

# Player model configuration — defaults are read from models.config.json at project root.
# Set PLAYER_MODELS here only to override. Format: LiteLLM-compatible model strings.
# Any LiteLLM-supported provider works: https://docs.litellm.ai/docs/providers
# Examples: groq/llama3-70b-8192, mistral/mistral-large-latest, cohere/command-r-plus
# PLAYER_MODELS=["openai/gpt-4o","anthropic/claude-3-5-haiku-20241022","gemini/gemini-2.0-flash","ollama_chat/llama3"]

# Provider API keys — add only the keys for providers in PLAYER_MODELS
# LiteLLM reads these automatically from environment (no code changes needed to add a new provider)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OLLAMA_API_BASE=http://localhost:11434

# CORS allowed origins — JSON array of allowed frontend origins.
# Dev: Vite (5173) + legacy Next.js (3000) are included in the default.
# Production: set this env var to your VPS frontend origin, e.g.:
# CORS_ORIGINS=["https://poker.yourdomain.com"]
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Redis — required for SSE broadcast (Phase 3)
# Start Redis via: docker compose up -d redis
REDIS_URL=redis://localhost:6379

# Game loop — seconds to wait between hands in the continuous game loop
HAND_DELAY_SECONDS=3
