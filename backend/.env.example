# LLM Poker Arena — Backend Environment Variables
# Copy this file to .env and fill in your credentials.
# NEVER commit .env — it is gitignored.

# Player model configuration — list of LiteLLM-compatible model strings
# Format: "provider/model-name" — the prefix routes to the right API
# Any LiteLLM-supported provider works: https://docs.litellm.ai/docs/providers
# Examples: groq/llama3-70b-8192, mistral/mistral-large-latest, cohere/command-r-plus
PLAYER_MODELS=["openai/gpt-4o","anthropic/claude-3-5-haiku-20241022","gemini/gemini-2.0-flash","ollama_chat/llama3"]

# Provider API keys — add only the keys for providers in PLAYER_MODELS
# LiteLLM reads these automatically from environment (no code changes needed to add a new provider)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OLLAMA_API_BASE=http://localhost:11434

# CORS allowed origins for Next.js frontend (JSON array format)
CORS_ORIGINS=["http://localhost:3000"]
